#!/bin/sh

HERE=$(dirname "$(readlink -f "$0")")
ROOT="$HERE"/../..

COMMANDS="$ROOT/etc/pier.dat"
LOG="$ROOT/var/log/pierdat.log"

# Each seeder owns a session, so shutdown also reaches its descendants.
command -v setsid >/dev/null 2>&1 || {
    printf '%s\n' 'pierdatd requires setsid (util-linux or BusyBox).' >&2
    exit 1
}

terminate() {
    trap '' HUP INT TERM QUIT
    for pid in $CHILD_PIDS; do
        kill -TERM "-$pid" 2>/dev/null || :
    done

    remaining=5
    while [ "$remaining" -gt 0 ]; do
        running=
        for pid in $CHILD_PIDS; do
            kill -0 "-$pid" 2>/dev/null && running=yes
        done
        [ -n "$running" ] || break
        sleep 1
        remaining=$((remaining - 1))
    done

    for pid in $CHILD_PIDS; do
        kill -KILL "-$pid" 2>/dev/null || :
        wait "$pid" 2>/dev/null || :
    done
}


seed_forever() {
    if [ ! -f "$COMMANDS" ]; then
        echo "$COMMANDS not found."
        return 1
    fi

    echo "Starting seeding processes from $COMMANDS..."

    # Initialize a variable to hold child PIDs
    CHILD_PIDS=""

    # Read each line from the data file and execute it
    while IFS= read -r cmd || [ -n "$cmd" ]; do

        cmd="${cmd#"${cmd%%[![:space:]]*}"}"
        cmd="${cmd%"${cmd##*[![:space:]]}"}"

        # Skip empty lines and comments
        [ -z "$cmd" ] && continue
        [ "${cmd#\#}" != "$cmd" ] && continue

        echo "Seeding: $cmd"

        # Start the command directly and capture its PID
        setsid sh -c "exec $cmd" >> "$LOG" 2>&1 &
        pid=$!

        # Add the PID to the list of child PIDs
        CHILD_PIDS="$CHILD_PIDS $pid"
    done < "$COMMANDS"

    export CHILD_PIDS

    wait
}


# Clean up child processes on exit
trap terminate 0
trap 'exit 0' HUP INT TERM QUIT

seed_forever
